FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN python3 -m venv /opt/iron-venv \
  && /opt/iron-venv/bin/pip install --no-cache-dir Pillow \
  && /opt/iron-venv/bin/python tools/cc0_soundtrack.py \
  && /opt/iron-venv/bin/python tools/iron_shift_branding.py \
  && /opt/iron-venv/bin/python build.py \
  && cp dist/riposte-frontline.html dist/index.html \
  && printf 'User-agent: *\nDisallow: /\n' > dist/robots.txt \
  && rm -f dist/sitemap.xml \
  && test -s dist/index.html \
  && test -s dist/manifest.webmanifest \
  && test -s dist/favicon.ico
RUN cd game-server && npm install --omit=dev --no-audit --no-fund
ENV NODE_ENV=production
EXPOSE 10000
CMD ["node","game-server/server.js"]
